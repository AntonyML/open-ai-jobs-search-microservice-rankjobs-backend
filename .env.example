# ── Base de datos (obligatoria) ─────────────────────────────────────
# DEBE ser la misma Supabase/PostgreSQL que la API principal.
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/jobs

# ── Seguridad (obligatoria) ─────────────────────────────────────────
# DEBE ser el mismo secreto que la API principal: deriva la clave
# Fernet que descifra las API keys de los usuarios.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256

# ── LLM ─────────────────────────────────────────────────────────────
# Proveedor por defecto (anthropic, openai, nvidia_nim, lm_studio)
LLM_DEFAULT_PROVIDER=anthropic
# Timeout de llamadas LLM (segundos)
LLM_TIMEOUT=180

# Keys globales — SOLO fallback si el usuario no tiene credencial
# cifrada en la BD (las del usuario se descifran con Fernet).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_NIM_API_KEY=

# Base URL para proveedores locales (LM Studio)
LM_STUDIO_API_BASE=http://localhost:1234/v1

# ── Servidor ────────────────────────────────────────────────────────
# Puerto HTTP (solo para healthcheck; en producción se recomienda
# correr únicamente el worker: python -m app.worker)
PORT=8002

# ── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
