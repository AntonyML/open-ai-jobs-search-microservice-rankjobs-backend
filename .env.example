# ── Base de datos ──────────────────────────────────────────────
# La MISMA base de datos que la API principal. La cola de ranking
# (execution_jobs / execution_job_items) vive aquí: la API la crea,
# este microservicio la procesa.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/postgres

# ── Seguridad ──────────────────────────────────────────────────
# El MISMO JWT_SECRET_KEY que usa la API principal: las API keys de
# los usuarios están cifradas con este secreto (Fernet derivado).
JWT_SECRET_KEY=change-me

# ── LLM (opcional — normalmente se usan las credenciales cifradas del usuario) ──
LLM_DEFAULT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_NIM_API_KEY=
LM_STUDIO_API_BASE=http://localhost:1234/v1

# ── Puerto HTTP (solo si usas uvicorn app.main:app) ───────────
PORT=8002
